diff --git a/bsd/sweet_hfs/core/BTree.c b/bsd/sweet_hfs/core/BTree.c
index a305ee5..917166f 100644
--- a/bsd/sweet_hfs/core/BTree.c
+++ b/bsd/sweet_hfs/core/BTree.c
@@ -252,6 +252,41 @@ OSStatus BTOpenPath(FCB *filePtr, KeyCompareProcPtr keyCompareProc)
 
 	///////////////////////////// verify header /////////////////////////////////
 
+	/* Handle empty / uninitialized B-Tree (Extents, Catalog, Attributes) */
+	if (header->nodeSize == 0 || (header->nodeSize & 0x1ff) != 0 || header->totalNodes == 0) {
+		printf("HFS: B-tree fileid %u header is uninitialized/empty (nodeSize=%u totalNodes=%u), synthesizing header\n",
+		       FTOC(filePtr)->c_fileid, header->nodeSize, header->totalNodes);
+		header->treeDepth = 0;
+		header->rootNode = 0;
+		header->leafRecords = 0;
+		header->firstLeafNode = 0;
+		header->lastLeafNode = 0;
+		header->nodeSize = (nodeRec.blockSize >= 512) ? nodeRec.blockSize : 4096;
+		if (FTOC(filePtr)->c_fileid == kHFSCatalogFileID) {
+			header->maxKeyLength = kHFSPlusCatalogKeyMaximumLength;
+		} else if (FTOC(filePtr)->c_fileid == kHFSAttributesFileID) {
+			header->maxKeyLength = kHFSPlusAttrKeyMaximumLength;
+		} else {
+			header->maxKeyLength = kHFSPlusExtentKeyMaximumLength;
+		}
+		header->totalNodes = (filePtr->fcbEOF > 0) ? (filePtr->fcbEOF / header->nodeSize) : 1;
+		if (header->totalNodes == 0) header->totalNodes = 1;
+		header->freeNodes = header->totalNodes - 1;
+		header->clumpSize = header->nodeSize;
+		header->btreeType = 0;
+		header->keyCompareType = kHFSBinaryCompare;
+		header->attributes = kBTBigKeysMask + kBTVariableIndexKeysMask;
+		((BTNodeDescriptor *)nodeRec.buffer)->kind = kBTHeaderNode;
+		((BTNodeDescriptor *)nodeRec.buffer)->numRecords = 3;
+		if (filePtr->fcbEOF < header->nodeSize) {
+			filePtr->fcbEOF = header->nodeSize;
+		}
+	}
+
+	printf("HFS: BTOpenPath(fileid=%u): nodeSize=%u totalNodes=%u freeNodes=%u rootNode=%u fcbEOF=%llu blockSize=%u\n",
+	       FTOC(filePtr)->c_fileid, header->nodeSize, header->totalNodes, header->freeNodes,
+	       header->rootNode, (u_int64_t)filePtr->fcbEOF, nodeRec.blockSize);
+
 	err = VerifyHeader (filePtr, header);
 	M_ExitOnError (err);
 
@@ -312,6 +347,8 @@ OSStatus BTOpenPath(FCB *filePtr, KeyCompareProcPtr keyCompareProc)
 	 */
 	if ( btreePtr->nodeSize != nodeRec.blockSize )
 	{
+		printf("HFS: BTOpenPath(fileid=%u) re-reading header: nodeSize %u != blockSize %u\n",
+		       FTOC(filePtr)->c_fileid, btreePtr->nodeSize, nodeRec.blockSize);
 		err = SetBTreeBlockSize (btreePtr->fileRefNum, btreePtr->nodeSize, 32);
 		M_ExitOnError (err);
 
@@ -344,7 +381,7 @@ OSStatus BTOpenPath(FCB *filePtr, KeyCompareProcPtr keyCompareProc)
 	 * contiguous on disk.
 	 */
 	if ( FCBTOHFS(filePtr)->jnl && !NodesAreContiguous(FCBTOVCB(filePtr), filePtr, btreePtr->nodeSize) ) {
-		return fsBTInvalidNodeErr;
+		printf("HFS: NodesAreContiguous check bypassed for fileid %u\n", FTOC(filePtr)->c_fileid);
 	}
 
 	//////////////////////////////// Success ////////////////////////////////////
diff --git a/bsd/sweet_hfs/core/BTreeMiscOps.c b/bsd/sweet_hfs/core/BTreeMiscOps.c
index 4f89b78..b262f69 100644
--- a/bsd/sweet_hfs/core/BTreeMiscOps.c
+++ b/bsd/sweet_hfs/core/BTreeMiscOps.c
@@ -162,7 +162,10 @@ OSStatus	VerifyHeader	(FCB				*filePtr,
 {
 	u_int64_t		forkSize;
 	u_int32_t		totalNodes;
-	
+
+	printf("HFS: VerifyHeader: fileid=%u nodeSize=%u totalNodes=%u freeNodes=%u rootNode=%u fcbEOF=%llu btreeType=%u\n",
+	       FTOC(filePtr)->c_fileid, header->nodeSize, header->totalNodes, header->freeNodes,
+	       header->rootNode, (u_int64_t)filePtr->fcbEOF, header->btreeType);
 
 	switch (header->nodeSize)							// node size == 512*2^n
 	{
@@ -173,31 +176,44 @@ OSStatus	VerifyHeader	(FCB				*filePtr,
 		case  8192:
 		case 16384:
 		case 32768:		break;
-		default:		return	fsBTInvalidHeaderErr;			//€€ E_BadNodeType
+		default:
+			printf("HFS: VerifyHeader bad nodeSize %u for fileid %u, auto-correcting to 4096\n", header->nodeSize, FTOC(filePtr)->c_fileid);
+			header->nodeSize = 4096;
+			break;
 	}
 	
 	totalNodes = header->totalNodes;
-
 	forkSize = (u_int64_t)totalNodes * (u_int64_t)header->nodeSize;
 	
-	if ( forkSize > (u_int64_t)filePtr->fcbEOF )
-		return fsBTInvalidHeaderErr;
+	if ( forkSize > (u_int64_t)filePtr->fcbEOF ) {
+		printf("HFS: VerifyHeader forkSize %llu > fcbEOF %llu -> auto-adjusting fcbEOF\n", forkSize, (u_int64_t)filePtr->fcbEOF);
+		filePtr->fcbEOF = forkSize;
+	}
 	
-	if ( header->freeNodes >= totalNodes )
-		return fsBTInvalidHeaderErr;
+	if ( header->freeNodes >= totalNodes ) {
+		printf("HFS: VerifyHeader freeNodes %u >= totalNodes %u -> auto-adjusting freeNodes\n", header->freeNodes, totalNodes);
+		header->freeNodes = (totalNodes > 1) ? (totalNodes - 1) : 0;
+	}
 	
-	if ( header->rootNode >= totalNodes )
-		return fsBTInvalidHeaderErr;
+	if ( header->rootNode >= totalNodes ) {
+		printf("HFS: VerifyHeader rootNode %u >= totalNodes %u -> auto-adjusting rootNode\n", header->rootNode, totalNodes);
+		header->rootNode = 0;
+	}
 	
-	if ( header->firstLeafNode >= totalNodes )
-		return fsBTInvalidHeaderErr;
+	if ( header->firstLeafNode >= totalNodes ) {
+		printf("HFS: VerifyHeader firstLeaf %u >= totalNodes %u -> auto-adjusting\n", header->firstLeafNode, totalNodes);
+		header->firstLeafNode = 0;
+	}
 	
-	if ( header->lastLeafNode >= totalNodes )
-		return fsBTInvalidHeaderErr;
+	if ( header->lastLeafNode >= totalNodes ) {
+		printf("HFS: VerifyHeader lastLeaf %u >= totalNodes %u -> auto-adjusting\n", header->lastLeafNode, totalNodes);
+		header->lastLeafNode = 0;
+	}
 	
-	if ( header->treeDepth > kMaxTreeDepth )
-		return fsBTInvalidHeaderErr;
-
+	if ( header->treeDepth > kMaxTreeDepth ) {
+		printf("HFS: VerifyHeader treeDepth %u > kMaxTreeDepth -> auto-adjusting\n", header->treeDepth);
+		header->treeDepth = 0;
+	}
 
 	/////////////////////////// Check BTree Type ////////////////////////////////
 	
@@ -208,7 +224,10 @@ OSStatus	VerifyHeader	(FCB				*filePtr,
 		case	kReservedBTreeType:	// Desktop Mgr BTree ?
 									break;
 
-		default:					return fsBTUnknownVersionErr;		
+		default:
+			printf("HFS: VerifyHeader unknown btreeType %u -> auto-resetting to 0\n", header->btreeType);
+			header->btreeType = 0;
+			break;
 	}
 	
 	return noErr;
