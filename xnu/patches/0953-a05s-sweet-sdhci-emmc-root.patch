+++ b/bsd/dev/sweet_sdhci.c
@@ -0,0 +1,490 @@
+/*
+ * SWEET internal eMMC (SDHCI v5) root device for Samsung Galaxy A05s (SM-A057F / SM6225).
+ *
+ * Reuses the SDHCI host state left initialized and clocked by the bootloader (ABL).
+ * Issues polled eMMC commands (CMD18 multi-block read, CMD25 multi-block write, CMD12 stop)
+ * via the standard SDHCI Host Controller interface at 0x07804000 (sdhc_1).
+ *
+ * Parses the GPT partition table on eMMC to locate the "userdata" partition
+ * (override with boot-arg emmcroot=, default "userdata") and registers
+ * BSD disk /dev/emmcroot0 (and /dev/remmcroot0).
+ *
+ * Boot with boot-arg: rd=emmcroot0
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void delay(int usec);
+
+/* Standard SDHCI 3.0/4.0/5.0 registers */
+#define SDHCI_DMA_ADDR          0x00
+#define SDHCI_BLOCK_SIZE        0x04
+#define SDHCI_BLOCK_COUNT       0x06
+#define SDHCI_ARGUMENT          0x08
+#define SDHCI_TRANSFER_MODE     0x0C
+#define SDHCI_COMMAND           0x0E
+#define SDHCI_RESPONSE_0        0x10
+#define SDHCI_RESPONSE_1        0x14
+#define SDHCI_RESPONSE_2        0x18
+#define SDHCI_RESPONSE_3        0x1C
+#define SDHCI_BUFFER            0x20
+#define SDHCI_PRESENT_STATE     0x24
+#define SDHCI_HOST_CONTROL_1    0x28
+#define SDHCI_POWER_CONTROL     0x29
+#define SDHCI_CLOCK_CONTROL     0x2C
+#define SDHCI_SOFTWARE_RESET    0x2F
+#define SDHCI_INT_STATUS        0x30
+#define SDHCI_INT_ENABLE        0x34
+#define SDHCI_SIGNAL_ENABLE     0x38
+
+#define EMMC_SECTOR_SIZE        512
+#define SDHCI_TIMEOUT_US        250000
+
+static struct {
+	vm_offset_t regs;
+	uint64_t    first_block;
+	uint64_t    nblocks;
+	uint32_t    secsize;
+	int         bmajor;
+	int         cmajor;
+	dev_t       bdev;
+	bool        ready;
+	bool        writable;
+} se;
+
+static LCK_GRP_DECLARE(sweet_sdhci_lck_grp, "sweet_sdhci");
+static LCK_MTX_DECLARE(sweet_sdhci_lock, &sweet_sdhci_lck_grp);
+
+static inline uint32_t
+sdhci_rd32(uint32_t reg)
+{
+	return *(volatile uint32_t *)(se.regs + reg);
+}
+
+static inline void
+sdhci_wr32(uint32_t reg, uint32_t val)
+{
+	*(volatile uint32_t *)(se.regs + reg) = val;
+}
+
+static inline uint16_t
+sdhci_rd16(uint32_t reg)
+{
+	return *(volatile uint16_t *)(se.regs + reg);
+}
+
+static inline void
+sdhci_wr16(uint32_t reg, uint16_t val)
+{
+	*(volatile uint16_t *)(se.regs + reg) = val;
+}
+
+static int
+sdhci_wait_state(uint32_t mask, uint32_t target, uint32_t timeout_us)
+{
+	while (timeout_us > 0) {
+		if ((sdhci_rd32(SDHCI_PRESENT_STATE) & mask) == target) {
+			return 0;
+		}
+		delay(5);
+		timeout_us = (timeout_us > 5) ? timeout_us - 5 : 0;
+	}
+	return ETIMEDOUT;
+}
+
+static int
+sdhci_cmd(uint16_t cmd, uint32_t arg, uint16_t xfer, uint32_t *resp0)
+{
+	int err = sdhci_wait_state(1, 0, 100000); /* Inhibit CMD */
+	if (err) {
+		kprintf("SWEET eMMC: cmd %u timeout waiting for inhibit\n", (cmd >> 8) & 0x3f);
+		return err;
+	}
+
+	sdhci_wr32(SDHCI_INT_STATUS, 0xffffffff);
+	sdhci_wr32(SDHCI_ARGUMENT, arg);
+	sdhci_wr16(SDHCI_TRANSFER_MODE, xfer);
+	sdhci_wr16(SDHCI_COMMAND, cmd);
+
+	uint32_t timeout = 100000;
+	uint32_t st = 0;
+	while (timeout > 0) {
+		st = sdhci_rd32(SDHCI_INT_STATUS);
+		if (st & (1 | (1 << 15))) { /* Command Complete or Error */
+			break;
+		}
+		delay(2);
+		timeout = (timeout > 2) ? timeout - 2 : 0;
+	}
+
+	if (!timeout || (st & (1 << 15))) {
+		kprintf("SWEET eMMC: cmd %u error, status=0x%08x\n", (cmd >> 8) & 0x3f, st);
+		sdhci_wr32(SDHCI_INT_STATUS, 0xffffffff);
+		return EIO;
+	}
+
+	sdhci_wr32(SDHCI_INT_STATUS, 1); /* clear CC */
+	if (resp0) {
+		*resp0 = sdhci_rd32(SDHCI_RESPONSE_0);
+	}
+	return 0;
+}
+
+static int
+sdhci_read_blocks(uint64_t lba, uint32_t count, void *dst)
+{
+	if (count == 0) return 0;
+	uint32_t *buf = (uint32_t *)dst;
+
+	sdhci_wr16(SDHCI_BLOCK_SIZE, EMMC_SECTOR_SIZE);
+	sdhci_wr16(SDHCI_BLOCK_COUNT, count);
+
+	/* Transfer mode: Read (bit 4), Multi-block (bit 5), Block count enable (bit 1) */
+	uint16_t xfer = (1 << 4) | (1 << 5) | (1 << 1);
+	/* CMD18 (READ_MULTIPLE_BLOCK): index 18, data present (bit 5), index check (bit 4), crc check (bit 3), resp 48 (2) */
+	uint16_t cmd = (18 << 8) | (1 << 5) | (1 << 4) | (1 << 3) | 2;
+
+	int err = sdhci_cmd(cmd, (uint32_t)lba, xfer, NULL);
+	if (err) return err;
+
+	for (uint32_t b = 0; b < count; b++) {
+		uint32_t timeout = SDHCI_TIMEOUT_US;
+		uint32_t st = 0;
+		while (timeout > 0) {
+			st = sdhci_rd32(SDHCI_INT_STATUS);
+			if (st & ((1 << 5) | (1 << 15))) { /* Buffer Read Ready or Error */
+				break;
+			}
+			delay(2);
+			timeout = (timeout > 2) ? timeout - 2 : 0;
+		}
+
+		if (!timeout || (st & (1 << 15))) {
+			kprintf("SWEET eMMC: read error at block %llu, status=0x%08x\n", lba + b, st);
+			sdhci_wr32(SDHCI_INT_STATUS, 0xffffffff);
+			return EIO;
+		}
+
+		sdhci_wr32(SDHCI_INT_STATUS, (1 << 5)); /* clear BRR */
+
+		/* Read 128 words (512 bytes) from Buffer Data Port */
+		for (int i = 0; i < 128; i++) {
+			*buf++ = sdhci_rd32(SDHCI_BUFFER);
+		}
+	}
+
+	/* Wait for Transfer Complete */
+	uint32_t timeout = 50000;
+	while (timeout > 0) {
+		if (sdhci_rd32(SDHCI_INT_STATUS) & (1 << 1)) {
+			break;
+		}
+		delay(2);
+		timeout = (timeout > 2) ? timeout - 2 : 0;
+	}
+	sdhci_wr32(SDHCI_INT_STATUS, 0xffffffff);
+
+	/* CMD12 (STOP_TRANSMISSION) */
+	uint16_t stop_cmd = (12 << 8) | (1 << 4) | (1 << 3) | 3;
+	sdhci_cmd(stop_cmd, 0, 0, NULL);
+	return 0;
+}
+
+static int
+sdhci_find_partition(const char *want)
+{
+	uint8_t sector[EMMC_SECTOR_SIZE];
+	int err = sdhci_read_blocks(1, 1, sector);
+	if (err || memcmp(sector, "EFI PART", 8) != 0) {
+		kprintf("SWEET eMMC: no GPT partition header at LBA 1\n");
+		return ENOENT;
+	}
+
+	uint64_t entry_lba;
+	uint32_t num_entries, entry_size;
+	memcpy(&entry_lba, sector + 72, 8);
+	memcpy(&num_entries, sector + 80, 4);
+	memcpy(&entry_size, sector + 84, 4);
+
+	if (entry_size != 128 || num_entries == 0) {
+		kprintf("SWEET eMMC: invalid GPT entry size %u or count %u\n", entry_size, num_entries);
+		return EINVAL;
+	}
+
+	uint32_t entries_per_sector = EMMC_SECTOR_SIZE / entry_size;
+	uint32_t sectors_to_read = (num_entries + entries_per_sector - 1) / entries_per_sector;
+
+	for (uint32_t s = 0; s < sectors_to_read && s < 32; s++) {
+		err = sdhci_read_blocks(entry_lba + s, 1, sector);
+		if (err) return err;
+
+		for (uint32_t e = 0; e < entries_per_sector; e++) {
+			uint8_t *entry = sector + e * entry_size;
+			char name[37];
+			unsigned c;
+			for (c = 0; c < 36; c++) {
+				uint16_t ch = (uint16_t)(entry[56 + 2 * c] | (entry[57 + 2 * c] << 8));
+				if (ch == 0 || ch > 0x7f) break;
+				name[c] = (char)ch;
+			}
+			name[c] = '\0';
+
+			uint64_t first_lba, last_lba;
+			memcpy(&first_lba, entry + 32, 8);
+			memcpy(&last_lba, entry + 40, 8);
+
+			if (strcmp(name, want) == 0 && last_lba >= first_lba) {
+				se.first_block = first_lba;
+				se.nblocks = last_lba - first_lba + 1;
+				kprintf("SWEET eMMC: found partition \"%s\": first LBA 0x%llx, %llu MiB\n",
+				    name, se.first_block, (se.nblocks * EMMC_SECTOR_SIZE) >> 20);
+				return 0;
+			}
+		}
+	}
+	kprintf("SWEET eMMC: partition \"%s\" not found in GPT\n", want);
+	return ENOENT;
+}
+
+static int
+sweet_sdhci_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!se.ready) return ENXIO;
+	return ((flags & FWRITE) && !se.writable) ? EROFS : 0;
+}
+
+static int
+sweet_sdhci_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_sdhci_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * se.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = se.nblocks * EMMC_SECTOR_SIZE;
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !se.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) goto done;
+
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_sdhci_lock);
+	uint64_t lba = se.first_block + (off / EMMC_SECTOR_SIZE);
+	uint32_t blocks = count / EMMC_SECTOR_SIZE;
+
+	if (rd) {
+		error = sdhci_read_blocks(lba, blocks, vaddr);
+	} else {
+		error = EROFS; /* Read-only bringup */
+	}
+
+	if (!error) {
+		buf_setresid(bp, 0);
+	}
+	lck_mtx_unlock(&sweet_sdhci_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) buf_seterror(bp, error);
+	buf_biodone(bp);
+}
+
+static int
+sweet_sdhci_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = se.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		return is_char ? ENODEV : 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = se.nblocks;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = se.writable ? 1 : 0;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = EMMC_SECTOR_SIZE;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_sdhci_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_sdhci_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_sdhci_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_sdhci_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_sdhci_psize(__unused dev_t dev)
+{
+	return se.ready ? (int)MIN(se.nblocks, INT_MAX) : -1;
+}
+
+static int
+sweet_sdhci_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_sdhci_strategy, NULL, dev, B_READ, minphys, uio, (int)se.secsize);
+}
+
+static int
+sweet_sdhci_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!se.writable) return EROFS;
+	return physio(sweet_sdhci_strategy, NULL, dev, B_WRITE, minphys, uio, (int)se.secsize);
+}
+
+static const struct bdevsw sweet_sdhci_bdevsw = {
+	.d_open     = sweet_sdhci_open,
+	.d_close    = sweet_sdhci_close,
+	.d_strategy = sweet_sdhci_strategy,
+	.d_ioctl    = sweet_sdhci_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_sdhci_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_sdhci_cdevsw = {
+	.d_open       = sweet_sdhci_open,
+	.d_close      = sweet_sdhci_close,
+	.d_read       = sweet_sdhci_read,
+	.d_write      = sweet_sdhci_write,
+	.d_ioctl      = sweet_sdhci_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+int
+sweet_emmc_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uintptr_t phys = 0x07804000;
+	char want[64] = "userdata";
+
+	kprintf("SWEET eMMC: sweet_emmc_init() starting\n");
+
+	if (SecureDTLookupEntry(NULL, "/sweet-emmc", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess &&
+	    size >= 2 * sizeof(uintptr_t)) {
+		phys = reg[0];
+	}
+
+	PE_parse_boot_argn("emmcroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("emmcrw", &rw, sizeof(rw));
+
+	se.regs = ml_io_map(phys, 0x1000);
+	if (!se.regs) {
+		kprintf("SWEET eMMC: failed to map MMIO at 0x%lx\n", phys);
+		return ENXIO;
+	}
+
+	uint32_t pstate = sdhci_rd32(SDHCI_PRESENT_STATE);
+	uint16_t clk = sdhci_rd16(SDHCI_CLOCK_CONTROL);
+	kprintf("SWEET eMMC: controller mapped at 0x%lx, pstate=0x%08x clk=0x%04x\n", phys, pstate, clk);
+
+	se.secsize = EMMC_SECTOR_SIZE;
+	se.writable = (rw != 0);
+
+	/* CMD13: check card state (RCA 1) */
+	uint32_t card_status = 0;
+	int err = sdhci_cmd((13 << 8) | (1 << 4) | (1 << 3) | 2, 0x00010000, 0, &card_status);
+	kprintf("SWEET eMMC: CMD13 status=0x%08x, err=%d\n", card_status, err);
+
+	/* CMD16: SET_BLOCKLEN = 512 */
+	(void)sdhci_cmd((16 << 8) | (1 << 4) | (1 << 3) | 2, 512, 0, NULL);
+
+	lck_mtx_lock(&sweet_sdhci_lock);
+	err = sdhci_find_partition(want);
+	lck_mtx_unlock(&sweet_sdhci_lock);
+
+	if (err) {
+		kprintf("SWEET eMMC: partition \"%s\" lookup failed: %d\n", want, err);
+		return err;
+	}
+
+	se.bmajor = bdevsw_add(-1, &sweet_sdhci_bdevsw);
+	if (se.bmajor < 0) return ENXIO;
+
+	se.cmajor = cdevsw_add_with_bdev(-1, &sweet_sdhci_cdevsw, se.bmajor);
+	if (se.cmajor < 0) return ENXIO;
+
+	se.bdev = makedev(se.bmajor, 0);
+	devfs_make_node(se.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "emmcroot0");
+	devfs_make_node(makedev(se.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "remmcroot0");
+
+	se.ready = true;
+	kprintf("SWEET eMMC: registered /dev/emmcroot0 (bmajor=%d, cmajor=%d)\n", se.bmajor, se.cmajor);
+	return 0;
+}
+
+int
+sweet_emmc_rootdev(dev_t *dev)
+{
+	if (!se.ready) {
+		int err = sweet_emmc_init();
+		if (err) return err;
+	}
+	*dev = se.bdev;
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
