+
+#define TOUCH_CHIPONE    3
+
+static int
+touch_spi_read(uint8_t cmd, uint8_t *rx_buf, unsigned len)
+{
+	if (!st.se) return EIO;
+	uint32_t m_cmd = (1u << 31) | (len & 0xffffu);
+	touch_wr(st.se, 0x600, m_cmd);
+	touch_wr(st.se, 0x700, (uint32_t)cmd);
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t status = touch_rd(st.se, SE_STATUS);
+		if ((status & (1u << 27)) || (touch_rd(st.se, 0x800) >= len)) {
+			break;
+		}
+		delay(2);
+	}
+	for (unsigned i = 0; i < len; ++i) {
+		rx_buf[i] = (uint8_t)(touch_rd(st.se, 0x900) & 0xffu);
+	}
+	touch_wr(st.se, 0x618, 0xffffffffu);
+	return 0;
+}
+
+static int
+touch_chipone(void)
+{
+	uint8_t buf[64] = {0};
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_spi_read(0x00, buf, 34);
+	if (err) {
+		return err;
+	}
+	unsigned n = buf[1] & 0x0fu;
+	if (n == 0 || n > TOUCH_MAX) {
+		touch_report(0, x, y);
+		return 0;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = &buf[2 + i * 6];
+		unsigned id = p[0] & 0x0fu;
+		if (id >= TOUCH_MAX) continue;
+		unsigned px = (((unsigned)p[1] & 0x0fu) << 8) | p[2];
+		unsigned py = (((unsigned)p[3] & 0x0fu) << 8) | p[4];
+		if (px > 1079) px = 1079;
+		if (py > 2399) py = 2399;
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
 
