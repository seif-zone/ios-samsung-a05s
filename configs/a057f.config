# configs/a057f.config: HakiOS kernel options and boot-arguments for Samsung Galaxy A05s (SM-A057F)
# Generated according to HakiOS driver configuration specification

# Kernel Driver Options (CONFIG_HAKIOS_*)
CONFIG_HAKIOS_CORE=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_BATTERY_SM5602=y
CONFIG_HAKIOS_FRAMEBUFFER_TOPAZ=y
CONFIG_HAKIOS_ADRENO=y
CONFIG_HAKIOS_MOCKFS_RAMDISK=y

# Boot Arguments for XNU Kernel (Passed via command line)
CONFIG_EARLYCON="msm_geni_serial,0x04a90000"
CONFIG_SERIAL=3
CONFIG_DEBUG=0x14e
CONFIG_KASLR=0
CONFIG_RD="md0"
CONFIG_PHYS_BASE="0xb0000000"
CONFIG_MEM_SIZE="1232MB"
CONFIG_FB_BASE="0x5c000000"
CONFIG_FB_WIDTH=1080
CONFIG_FB_HEIGHT=2400
CONFIG_FB_STRIDE=4320
CONFIG_BATTERY=1
CONFIG_TOUCHSCREEN=1
CONFIG_CPUS=4
CONFIG_BOOTCPU=0x100
CONFIG_GPU=1
CONFIG_GPU_MHZ=1114
CONFIG_SWEETFB_LOCK=1
CONFIG_APP_LOG=1
